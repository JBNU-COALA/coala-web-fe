# Leave this blank when the frontend and backend are served from the same origin.
# Set it only when the deployed frontend must call a separate backend origin.
API_BASE_URL=

# Public project token and ingestion host (US or EU), injected at build time.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional aggregate-only shared dashboard iframe src. Not a personal API key.
VITE_POSTHOG_DASHBOARD_EMBED_URL=

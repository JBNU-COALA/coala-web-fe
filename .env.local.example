# Local dev proxy target. Override this in .env.local when testing a remote backend.
API_PROXY_TARGET=http://localhost:8080

# PostHog public project token only. Never put a personal API key in VITE_ variables.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional aggregate-only shared dashboard iframe src. Shared links are not private.
VITE_POSTHOG_DASHBOARD_EMBED_URL=
# Keep local developer traffic out unless explicitly testing.
VITE_POSTHOG_ENABLE_DEV=false
